{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-electron",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/electron/**/*.ts", "src/creature/**/*.ts", "src/events/**/*.ts", "src/interaction/**/*.ts", "src/persistence/**/*.ts", "src/shared/**/*.ts"]
}
